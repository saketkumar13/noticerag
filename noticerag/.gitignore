# ==============================================================================
# 🏛️ NITA Campus Intelligence Assistant - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL: NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.toml
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# 2. Python & Bytecode Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 3. Virtual Environments
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 4. IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*.swn
*~
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# ------------------------------------------------------------------------------
# 5. Operating System Generated Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 6. Testing, Quality & Coverage
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# ------------------------------------------------------------------------------
# 7. Model Weights, Embeddings & OCR Caches
# ------------------------------------------------------------------------------
.cache/
hf_cache/
fastembed_cache/
models/
rapidocr_models/

# ------------------------------------------------------------------------------
# 8. Data Ingestion, PDFs, OCR & Generated Artifacts
# ------------------------------------------------------------------------------
# Ignore all noticerag local data
data/

# Raw downloaded PDFs from NITA notice board
**/data/pdfs/
*.pdf

# OCR extracted text and intermediate structured outputs
**/data/extracted_text/
**/data/metadata/
**/data/chunks/
**/data/checkpoints/

# Vector storage (Qdrant) & Lexical Indexes (BM25)
**/data/qdrant_db/
**/data/indexes/
*.pkl
*.pickle
*.parquet

# SQLite databases & journals
**/data/*.db
**/data/*.db-journal
*.db
*.db-journal
*.sqlite
*.sqlite3

# Generated execution logs & reports
**/data/logs/
**/data/reports/
*.log

# ------------------------------------------------------------------------------
# 9. Whitelist Essential Test Fixtures & Documentation
# ------------------------------------------------------------------------------
!data/evaluation/
!data/evaluation/retrieval_test_set.json
!docs/architecture.png
docs/sample_reference.png


